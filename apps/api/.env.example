# ParkCore API local environment. Copy to apps/api/.env.
# Do not use these local values in production.

# Runtime and browser access. Production accepts only exact HTTP(S) origins;
# separate multiple origins with commas and omit paths, trailing slashes, and wildcards.
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173

# Security and authentication
# Use a unique secret of at least 32 characters outside local development.
JWT_SECRET=local-development-secret-change-before-production-1234
JWT_EXPIRES_IN=24h
AUTH_RATE_LIMIT_MAX=15
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Logging and local API reference
LOG_LEVEL=info
LOG_PRETTY=true
ENABLE_API_DOCS=false

# Local PostgreSQL started by pnpm docker:up
DATABASE_URL=postgresql://parkcore:parkcore@localhost:5432/parkcore-db?schema=public
