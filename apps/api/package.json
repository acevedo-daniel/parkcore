{
  "name": "@parkcore/api",
  "version": "1.0.0",
  "description": "Parking operations system Express API and domain services.",
  "homepage": "https://parkcore-app.vercel.app/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/acevedo-daniel/parkcore.git",
    "directory": "apps/api"
  },
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "pnpm prisma:generate && pnpm clean && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:dev": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:reset": "prisma migrate reset",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "showcase:refresh": "tsx src/scripts/showcase-refresh.ts",
    "db:setup": "pnpm prisma:generate && pnpm prisma:migrate:deploy && pnpm prisma:seed",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:openapi": "tsx src/scripts/generate-openapi.ts",
    "openapi:check": "tsx src/scripts/check-openapi.ts",
    "build:check": "pnpm build && tsx src/scripts/check-build-artifact.ts",
    "release:readiness": "pnpm openapi:check && pnpm build:check",
    "smoke:local": "tsx src/scripts/smoke-local.ts",
    "smoke:remote": "tsx src/scripts/smoke-api.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "quality": "pnpm lint && pnpm typecheck && pnpm test",
    "quality:ci": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm generate:openapi"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@scalar/express-api-reference": "^0.10.18",
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "pino-pretty": "^13.1.3",
    "prettier": "3.9.6",
    "prisma": "^7.10.0",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
