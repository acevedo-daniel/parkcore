{
  "name": "@parkcore/web",
  "version": "1.0.0",
  "description": "Bilingual React web client for ParkCore.",
  "homepage": "https://parkcore-app.vercel.app/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/acevedo-daniel/parkcore.git",
    "directory": "apps/web"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:check": "pnpm build && node ../../scripts/check-web-build-artifact.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:hardening": "playwright test --config playwright.hardening.config.ts",
    "test:e2e:local": "playwright test --config playwright.local-real-stack.config.ts --project=chromium",
    "test:e2e:production-preview": "playwright test --config playwright.production-preview.config.ts",
    "test:e2e:real": "playwright test --config playwright.real-stack.config.ts real-stack-smoke.spec.ts --project=chromium",
    "test:e2e:browser-qa": "playwright test --config playwright.real-stack.config.ts real-stack-smoke.spec.ts --project=chromium --project=firefox --project=edge",
    "test:e2e:responsive": "playwright test --config playwright.real-stack.config.ts responsive-production-qa.spec.ts --project=chromium"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@parkcore/api-client": "workspace:*",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-router": "^8.4.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^8.0.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/eslint-plugin-query": "^5.104.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "3.9.9",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
